# Test-only composer project. NOT covered by `vendor/*` above: that pattern is anchored to
# this file's directory and matches the root vendor/ only. Without this line `npm run beta`
# (git add -A) would commit ~98MB of WordPress core and PHPUnit to develop and beta, which
# deploy as raw git trees to live sites.
tests/vendor/

# Regenerates with the current git ref, so tracking it dirties the tree after every commit.
/vendor/composer/installed.php

# Local mai-sync environment config.
mai-sync.json
