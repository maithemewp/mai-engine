{
    "name": "maithemewp/mai-cache",
    "description": "Ergonomic remember()-pattern caching for WordPress transients and the object cache. SCRIPT_DEBUG-aware. Safe to bundle in several plugins on one WordPress site: the newest copy loads.",
    "type": "library",
    "license": "GPL-2.0-or-later",
    "homepage": "https://github.com/maithemewp/mai-cache",
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/maithemewp/mai-package-loader"
        }
    ],
    "require": {
        "php": ">=8.1",
        "maithemewp/mai-package-loader": "^0.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "brain/monkey": "^2.6"
    },
    "autoload-dev": {
        "psr-4": {
            "Mai\\Cache\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test-unit": "@php vendor/bin/phpunit"
    }
}
